rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function shopPath(shopId) {
      return /databases/$(database)/documents/shops/$(shopId);
    }

    function memberPath(shopId, uid) {
      return /databases/$(database)/documents/shops/$(shopId)/members/$(uid);
    }

    // One physical installation may authenticate as the worker or owner.
    // Keep a separate enrollment record per (deviceId, Firebase UID) pair.
    function devicePath(shopId, deviceId, uid) {
      return /databases/$(database)/documents/shops/$(shopId)/devices/$(deviceId + "__" + uid);
    }

    function shopActive(shopId) {
      let shop = get(shopPath(shopId)).data;
      return shop.status == "active"
        && (shop.subscriptionExpiresAtMs == null
          || request.time.toMillis() < shop.subscriptionExpiresAtMs);
    }

    function activeMember(shopId) {
      let member = get(memberPath(shopId, request.auth.uid)).data;
      return member.uid == request.auth.uid
        && member.shopId == shopId
        && member.status == "active"
        && member.role == request.auth.token.memberRole
        && request.auth.token.shopId == shopId;
    }

    function activeDevice(shopId) {
      let deviceId = request.auth.token.deviceId;
      let device = get(devicePath(shopId, deviceId, request.auth.uid)).data;
      return device.deviceId == deviceId
        && device.shopId == shopId
        && device.uid == request.auth.uid
        && device.status == "active"
        && device.role == request.auth.token.memberRole;
    }

    function belongsToShop(shopId) {
      return signedIn()
        && request.auth.token.shopId == shopId
        && request.auth.token.memberRole in ["owner", "worker"]
        && request.auth.token.deviceId is string
        && shopActive(shopId)
        && activeMember(shopId)
        && activeDevice(shopId);
    }

    function isOwner(shopId) {
      return belongsToShop(shopId) && request.auth.token.memberRole == "owner";
    }

    function isWorker(shopId) {
      return belongsToShop(shopId) && request.auth.token.memberRole == "worker";
    }

    function validCustomer(data, customerId) {
      return data.keys().hasOnly([
          "id", "shopId", "name", "phone", "segment",
          "creditCeilingCentimes", "payDay", "revision",
          "archivedAt", "createdAtMs"
        ])
        && data.keys().hasAll([
          "id", "shopId", "name", "phone", "segment",
          "creditCeilingCentimes", "payDay", "revision",
          "archivedAt", "createdAtMs"
        ])
        && data.id == customerId
        && data.shopId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.phone is string && data.phone.size() <= 32
        && data.segment is string && data.segment.size() <= 32
        && data.creditCeilingCentimes is int
        && data.creditCeilingCentimes >= 0
        && data.creditCeilingCentimes <= 9007199254740991
        && (data.payDay == null || (data.payDay is int && data.payDay >= 1 && data.payDay <= 31))
        && data.revision is int && data.revision >= 1
        && (data.archivedAt == null || (data.archivedAt is int && data.archivedAt > 0))
        && data.createdAtMs is int && data.createdAtMs > 0;
    }

    match /shops/{shopId} {
      allow read: if belongsToShop(shopId);
      allow write: if false;

      match /customers/{customerId} {
        allow read: if belongsToShop(shopId);
        allow create: if (isOwner(shopId) || isWorker(shopId))
          && validCustomer(request.resource.data, customerId)
          && request.resource.data.shopId == shopId
          && request.resource.data.revision == 1
          && request.resource.data.archivedAt == null
          && request.resource.data.createdAtMs <= request.time.toMillis() + 300000;
        allow update: if isOwner(shopId)
          && validCustomer(request.resource.data, customerId)
          && request.resource.data.shopId == resource.data.shopId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAtMs == resource.data.createdAtMs
          && request.resource.data.revision == resource.data.revision + 1;
        // Archive is an owner-only field update; hard delete is never allowed.
        allow delete: if false;
      }

      match /ledger/{eventId} {
        allow read: if belongsToShop(shopId);
        allow create: if (isOwner(shopId) || isWorker(shopId))
          && request.resource.data.eventId == eventId
          && request.resource.data.shopId == shopId
          && request.resource.data.customerId is string
          && exists(/databases/$(database)/documents/shops/$(shopId)/customers/$(request.resource.data.customerId))
          && request.resource.data.kind in ["debt", "payment"]
          && request.resource.data.amountCentimes is int
          && request.resource.data.amountCentimes > 0
          && request.resource.data.amountCentimes <= 9007199254740991
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 1000
          && request.resource.data.keys().hasOnly([
            "eventId", "shopId", "customerId", "kind", "amountCentimes",
            "note", "createdAtMs", "deviceId", "actorUid"
          ])
          && request.resource.data.createdAtMs is int
          && request.resource.data.createdAtMs > 0
          && request.resource.data.createdAtMs <= request.time.toMillis() + 300000
          && request.resource.data.deviceId == request.auth.token.deviceId
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if isOwner(shopId) || (
          belongsToShop(shopId) && request.auth.uid == resource.data.uid
        );
        allow write: if false;
      }

      match /members/{memberUid} {
        allow read: if isOwner(shopId) || (
          belongsToShop(shopId) && request.auth.uid == memberUid
        );
        allow write: if false;
      }
    }

    // Per-user shop index lets a signed-in user discover their own shop IDs.
    // It contains no customer or ledger data and is written only by trusted Admin SDK code.
    match /users/{userId}/shops/{shopId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
