rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function belongsToShop(shopId) {
      return signedIn() && request.auth.token.shopId == shopId;
    }

    function isOwner(shopId) {
      return belongsToShop(shopId) && request.auth.token.role == "owner";
    }

    function isWorker(shopId) {
      return belongsToShop(shopId) && request.auth.token.role == "worker";
    }

    match /shops/{shopId} {
      // Shop metadata and subscription are server-managed, never client-writable.
      allow read: if belongsToShop(shopId);
      allow write: if false;

      match /customers/{customerId} {
        allow read: if belongsToShop(shopId);
        allow create: if isOwner(shopId) || isWorker(shopId);
        allow update, delete: if isOwner(shopId);
      }

      match /ledger/{eventId} {
        allow read: if belongsToShop(shopId);
        // Ledger is append-only. Client updates/deletes are forbidden for all roles.
        allow create: if (isOwner(shopId) || isWorker(shopId))
          && request.resource.data.eventId == eventId
          && request.resource.data.shopId == shopId
          && request.resource.data.customerId is string
          && request.resource.data.kind in ["debt", "payment"]
          && request.resource.data.amountDzd is int
          && request.resource.data.amountDzd > 0
          && request.resource.data.createdAtMs is int
          && request.resource.data.deviceId is string
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if belongsToShop(shopId);
        // Device enrollment/revocation must be performed by trusted backend code.
        allow write: if false;
      }

      match /members/{memberUid} {
        allow read: if belongsToShop(shopId) && request.auth.uid == memberUid;
        allow write: if false;
      }
    }

    // Deny everything not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
